{
  "name": "dancefigures",
  "version": "1.0.0",
  "description": "Party PWA: turns dancers into animated stylized figures, fully on-device.",
  "scripts": {
    "prepare-assets": "node scripts/copy-wasm.mjs && node scripts/make-icons.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build && node scripts/netlify-headers.mjs && node scripts/verify-dist.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
